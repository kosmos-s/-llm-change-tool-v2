#!/bin/sh
if [ -x .venv/Scripts/python.exe ]; then
  exec .venv/Scripts/python.exe scripts/check_secrets.py
elif [ -x .venv/bin/python ]; then
  exec .venv/bin/python scripts/check_secrets.py
elif command -v py >/dev/null 2>&1; then
  exec py -3.11 scripts/check_secrets.py
else
  exec python3 scripts/check_secrets.py
fi
